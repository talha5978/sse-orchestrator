{
	"name": "sse-orchestrator",
	"version": "1.3.0",
	"description": "A resilient, ultra-lightweight, type-safe client-side SSE orchestrator with dual ESM/CJS distribution, backoff-jitter reconnection pipelines, and extended HTTP configurations.",
	"type": "module",
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"require": "./dist/index.cjs"
		},
		"./react": {
			"types": "./dist/react/index.d.ts",
			"import": "./dist/react/index.js",
			"require": "./dist/react/index.cjs"
		},
		"./server": {
			"types": "./dist/server/index.d.ts",
			"import": "./dist/server/index.js",
			"require": "./dist/server/index.cjs"
		}
	},
	"files": [
		"dist"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/talha5978/sse-orchestrator.git"
	},
	"homepage": "https://github.com/talha5978/sse-orchestrator#readme",
	"bugs": {
		"url": "https://github.com/talha5978/sse-orchestrator/issues"
	},
	"scripts": {
		"build": "tsup src/index.ts src/react/index.ts src/server/index.ts --format cjs,esm --dts",
		"test": "vitest run",
		"test:watch": "vitest",
		"format": "prettier --write \"**/*.{js,ts,tsx,jsx,json,md,css,scss}\""
	},
	"lint-staged": {
		"**/*.{js,ts,tsx,jsx,json,md,css,scss}": [
			"prettier --write"
		]
	},
	"keywords": [
		"sse",
		"server-sent-events",
		"streaming",
		"llm",
		"typescript",
		"type-safe",
		"fetch-stream"
	],
	"author": "Muhammad Talha",
	"license": "MIT",
	"devDependencies": {
		"@testing-library/react": "^16.3.2",
		"@types/node": "^25.9.2",
		"@types/react": "^19.2.17",
		"jsdom": "^29.1.1",
		"prettier": "^3.8.3",
		"react": "^19.2.7",
		"tsup": "^8.1.0",
		"typescript": "^6.0.3",
		"vitest": "^1.6.0"
	},
	"peerDependencies": {
		"react": ">=16.0"
	}
}
